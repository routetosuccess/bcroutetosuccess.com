---
// A stretch of the club's dotted route that joins one home page section to the next.
// It draws itself as you scroll down to it, and the last one ends at the yellow star.
// In browsers without scroll-driven animations it is simply shown whole. Decorative only.
interface Props {
  // Which way it winds: from the left edge to the right ('right') or back again ('left').
  direction?: 'right' | 'left';
  // End at the club's star instead of a stop.
  star?: boolean;
  // Tuck into the padding of the section above ('up', the default) or the one below ('down').
  pull?: 'up' | 'down';
}

const { direction = 'right', star = false, pull = 'up' } = Astro.props;
---

<div class:list={['route-connector', 'container', direction, `pull-${pull}`]} aria-hidden="true">
  <svg viewBox="0 0 1000 120" preserveAspectRatio="none" focusable="false">
    <path class="trail" d="M40 10C40 70 200 60 500 60S960 50 960 110" vector-effect="non-scaling-stroke" />
  </svg>
  <span class="dot start-dot"></span>
  {
    star ? (
      <svg class="end-star" viewBox="0 0 24 24" focusable="false">
        <path d="M12 0C13 8 16 11 24 12 16 13 13 16 12 24 11 16 8 13 0 12 8 11 11 8 12 0Z" />
      </svg>
    ) : (
      <span class="dot end-dot" />
    )
  }
</div>

<style>
  .route-connector {
    position: relative;
    height: 6rem;
  }

  .pull-up {
    margin-block: -2rem 1rem;
  }

  .pull-down {
    margin-block: 1rem -2rem;
  }

  /* Mirror it so the route zig-zags down the page. */
  .left {
    transform: scaleX(-1);
  }

  svg:not(.end-star) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .trail {
    fill: none;
    stroke: var(--ink);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 0.1 14;
  }

  .dot {
    position: absolute;
    width: 1.25rem;
    height: 1.25rem;
    border: 3px solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
    translate: -50% -50%;
  }

  .start-dot {
    left: 4%;
    top: 8%;
  }

  .end-dot,
  .end-star {
    left: 96%;
    top: 92%;
  }

  .end-dot {
    background: var(--club-blue);
  }

  .end-star {
    position: absolute;
    width: 2.75rem;
    height: 2.75rem;
    translate: -50% -50%;
    overflow: visible;
  }

  .end-star path {
    fill: var(--sun);
    stroke: var(--ink);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  /* Draw the route as it scrolls into view, then pop the end marker in. */
  @supports (animation-timeline: view()) {
    svg:not(.end-star) {
      animation: draw-trail linear both;
      animation-timeline: view();
      animation-range: entry 20% cover 55%;
    }

    .end-dot,
    .end-star {
      animation: arrive linear both;
      animation-timeline: view();
      animation-range: cover 50% cover 60%;
    }
  }

  @keyframes draw-trail {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes arrive {
    from {
      scale: 0;
    }
    to {
      scale: 1;
    }
  }
</style>
