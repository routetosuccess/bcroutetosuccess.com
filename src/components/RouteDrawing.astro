---
// The club's signature drawing: a dotted route that winds from a starting dot past two stops to a yellow star.
// On page load the route draws itself from left to right; then it keeps marching slowly and the star twinkles.
// Decorative only, so screen readers skip it.
interface Props {
  class?: string;
  /* Leave out the faded maths symbols behind the route, e.g. in small page headers. */
  glyphs?: boolean;
}

const { class: className, glyphs = true } = Astro.props;
---

<svg class:list={['route-drawing', className]} viewBox="0 0 400 340" aria-hidden="true" focusable="false">
  {
    glyphs && (
      <g class="math-glyphs">
        <text x="40" y="70">π</text>
        <text x="300" y="250">√</text>
        <text x="110" y="180">+</text>
        <text x="330" y="140">×</text>
        <text x="60" y="320">∑</text>
      </g>
    )
  }
  <g class="path-group">
    <path class="route" d="M30 300C120 300 80 210 170 200S270 130 220 90 300 40 340 55" />
    <circle class="start" cx="30" cy="300" r="10" />
    <circle class="stop" cx="170" cy="200" r="9" />
    <circle class="stop" cx="220" cy="90" r="9" />
  </g>
  <path class="star" d="M352 18C355 42 364 51 388 54 364 57 355 66 352 90 349 66 340 57 316 54 340 51 349 42 352 18Z" />
</svg>

<style>
  .route-drawing {
    display: block;
    overflow: visible;
  }

  /* The one big entrance on each page: the route is drawn from the start dot to the star. */
  .path-group {
    animation: draw-route 1.6s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
  }

  @keyframes draw-route {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  .route {
    fill: none;
    stroke: var(--ink);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 0.1 14;
    animation: march 1.5s linear infinite;
  }

  @keyframes march {
    to {
      stroke-dashoffset: -14.1;
    }
  }

  .start {
    fill: var(--club-blue);
    stroke: var(--ink);
    stroke-width: 3;
  }

  .stop {
    fill: var(--paper);
    stroke: var(--ink);
    stroke-width: 3;
  }

  .star {
    fill: var(--sun);
    stroke: var(--ink);
    stroke-width: 3;
    stroke-linejoin: round;
    transform-origin: 352px 54px;
    /* Pops in as the route reaches it, then twinkles. */
    animation:
      star-arrive 0.6s cubic-bezier(0.16, 1, 0.3, 1) 1.2s both,
      twinkle 3s ease-in-out 1.7s infinite;
  }

  @keyframes star-arrive {
    from {
      transform: scale(0) rotate(-45deg);
    }
  }

  @keyframes twinkle {
    50% {
      transform: scale(1.12) rotate(8deg);
    }
  }

  .math-glyphs text {
    font-family: var(--font-display);
    font-size: 40px;
    font-weight: 800;
    fill: color-mix(in srgb, var(--club-blue) 55%, transparent);
  }

</style>
