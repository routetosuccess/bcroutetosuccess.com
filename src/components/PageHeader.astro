---
// The graph-paper banner at the top of every page except the home page.
// On wider screens the club's route draws itself on the right, ending at the star.
import RouteDrawing from './RouteDrawing.astro';
import Sparkle from './Sparkle.astro';

interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
}

const { title, eyebrow, lead } = Astro.props;
---

<header class="page-header graph-paper">
  <div class="container header-inner">
    <div class="header-text">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>
        {title}
        <Sparkle class="header-sparkle" size="0.55em" />
      </h1>
      {lead && <p class="lead">{lead}</p>}
    </div>
    <RouteDrawing class="header-route" glyphs={false} />
  </div>
</header>

<style>
  .page-header {
    overflow: hidden;
    padding-block: 3rem 2.75rem;
    border-bottom: 2px dashed var(--club-blue);
  }

  .header-inner {
    display: grid;
    align-items: center;
    gap: 2rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 9vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  h1 :global(.header-sparkle) {
    margin-left: 0.1em;
    color: var(--club-blue);
    vertical-align: super;
  }

  .lead {
    max-width: 38rem;
    margin-bottom: 0;
  }

  /* Phones get the words only; the route needs room to read as a route. */
  .header-inner :global(.header-route) {
    display: none;
  }

  @media (min-width: 52rem) {
    .page-header {
      padding-block: 3.5rem 3rem;
    }

    .header-inner {
      grid-template-columns: 1fr 18rem;
    }

    .header-inner :global(.header-route) {
      display: block;
      width: 100%;
      margin-block: -1rem;
    }
  }
</style>
