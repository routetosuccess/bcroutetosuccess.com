---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ComingSoon from '../../components/ComingSoon.astro';
import ThemeArtwork from '../../components/themes/ThemeArtwork.astro';
import { countWord, formatDate, getCurrentCompetition, ordinal, registrationOpenText, registrationOpensText } from '../../lib/competitions';

const current = await getCurrentCompetition();

// What happens in each Round. Drafted from the usual MATHCOUNTS format: check with the club before launch.
const rounds = [
  {
    name: 'Sprint',
    about:
      'You work on your own through 30 questions in 50 minutes. Calculators are not allowed in this Round. Speed and accuracy both count.',
  },
  {
    name: 'Target',
    about:
      'There are 8 questions in all, handed out in 4 pairs. You get 6 minutes for each pair, and you finish one pair before the next is handed out. This Round focuses on depth, with harder problems that take more steps. Calculators are allowed in this Round.',
  },
  {
    name: 'Countdown',
    about: 'The top scorers go head to head on a buzzer, one problem at a time, in front of everyone.',
  },
];
const divisions = current?.divisions ?? [];

// Answers from the 2026 Competition FAQ sheet. Each answer is a list of bullet points (a point can have sub-points).
const faqs = [
  {
    q: 'Where is the competition located?',
    a: ['BASIS Chandler (main campus, not primary): 4825 S Arizona Ave, Chandler, AZ 85248.'],
  },
  {
    q: 'Can I attend even if I do not go to BASIS Chandler, or a BASIS Charter School?',
    a: ['Yes! This event is available to everyone, regardless of what school they attend.'],
  },
  {
    q: 'Can I walk in at the door without filling in registration beforehand?',
    a: [
      'You can walk in at the door, but you will need to complete the registration and pay the fee in order for your student to compete.',
    ],
  },
  {
    q: 'What do I need to bring?',
    a: ['Pencils, erasers, a calculator, a water bottle, and your thinking cap!'],
  },
  {
    q: 'Who do I compete with?',
    a: ['There are 2 grade divisions: grades 1–2 and grades 3–5. You will compete with students in your division.'],
  },
  {
    q: 'What is the fee for?',
    a: [
      'The fee goes towards donating high-demand items to Homeless Youth Connection, an organization that aims to minimize the effects of homelessness in students aged 13–21 who attend school in Arizona.',
    ],
  },
  {
    q: 'How do I buy lunch for my student?',
    a: ['Lunch for the students is included in the registration fee, so no other action is necessary!'],
  },
  {
    q: 'How will results come out?',
    a: [
      'Each student will be given an ID number on a name tag sticker on the day of the exam. To keep scores anonymous, we will send out the results by ID number.',
      'If you forget your ID number, you can always email us!',
    ],
  },
  {
    q: 'What will be tested?',
    a: [
      'The math questions will be harder than your typical school tests! Do not worry, this is just a competition for learning and exploration.',
    ],
  },
  {
    q: 'What is the written exam format?',
    a: [
      {
        text: 'There will be two testing rounds:',
        sub: [
          'Sprint: 30 questions, 50 minutes, no calculator.',
          'Target: 4 sets of 2 questions, 6 minutes for each set, calculator allowed.',
        ],
      },
    ],
  },
  {
    q: 'How does pick up and drop off work?',
    a: [
      'Parents can either stay the entire time in the gym or drop their kids off at 8:00 AM after check-in.',
      'Pick up will be around 12:00 PM, when the competition ends.',
      'A detailed schedule will be sent in the confirmation email.',
    ],
  },
  {
    q: 'What should I do to prepare?',
    a: [
      "This math competition is purely to test your child's skills, so preparation isn't required. If you would really like them to prepare, we recommend looking online for competition-style questions in their grade level range.",
    ],
    link: { href: '/sample-questions-2025.pdf', text: "Some sample questions from a past year's exam can be found here." },
  },
  {
    q: 'Where is the 6–8 division/team round?',
    a: [
      'This year, the competition no longer serves 6th–8th graders, and is one round shorter.',
      "This competition has gone through many changes in its lifetime, all made with our participants' best interests at heart. Our club prioritizes quality in everything we do, and this year we made the decision to host a smaller competition in order to maintain that quality. Despite this sad news, we hope everyone will check back next year to see which divisions are available then!",
    ],
  },
];

// Don't name the Beneficiary until the Club Adviser and the Beneficiary have agreed.
const beneficiaryText = current?.beneficiary
  ? current.beneficiary.confirmed
    ? current.beneficiary.name
    : 'a local youth charity'
  : undefined;

const mapUrl = current?.location
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(current.location)}`
  : undefined;
---

<BaseLayout
  title={current?.theme.name ? `${current.year} Math Competition: ${current.theme.name}` : 'Math Competition'}
  description="The yearly Math Competition run by Route to Success at BASIS Chandler."
  accent={current?.theme.color}
>
  {
    current ? (
      <section class:list={['competition-hero', { themed: current.theme.artwork }]}>
        <ThemeArtwork artwork={current.theme.artwork} />

        <div class="container hero-inner">
          <div class="hero-text">
            <p class="presents">
              Route to Success
              {current.coHost && (
                <>
                  <span class="times" aria-label="and">×</span>
                  {current.coHost}
                </>
              )}
            </p>
            <h1>
              {/* Largest to smallest: Math Competition, 7th Annual, the Theme, then at BASIS Chandler. */}
              {current.edition && <span class="edition">{ordinal(current.edition)} Annual </span>}
              <span class="event-name">Math Competition </span>
              {current.theme.name && <span class="theme-name">{current.theme.name} </span>}
              <span class="school">at BASIS Chandler</span>
            </h1>
          </div>

          <dl class="card details">
            {current.date && (
              <div>
                <dt>When</dt>
                <dd>{formatDate(current.date)}</dd>
              </div>
            )}
            {current.time && (
              <div>
                <dt>Time</dt>
                <dd>{current.time}</dd>
              </div>
            )}
            {current.grades && (
              <div>
                <dt>Who</dt>
                <dd>{current.grades} welcome!</dd>
              </div>
            )}
            {current.location && (
              <div>
                <dt>Where</dt>
                <dd>
                  BASIS Chandler
                  <br />
                  <a href={mapUrl}>{current.location}</a>
                </dd>
              </div>
            )}
          </dl>
        </div>
      </section>
    ) : (
      <PageHeader title="Math Competition" />
    )
  }

  <div class="container page-body">
    <p class="intro lead">
      Every year, Route to Success runs a Math Competition for students. Competitors solve problems across three Rounds,
      grouped into Divisions by grade.
    </p>

    <!-- The footer links to each of these sections by its id. -->
    <section id="register">
      <h2>Register</h2>
      {
        current?.registration ? (
          <div class="card register">
            {current.stage === 'upcoming' && <p>{registrationOpensText(current.registration)}</p>}
            {current.stage === 'registration-open' && (
              <p>{registrationOpenText(current.registration)}</p>
            )}
            {current.stage === 'registration-closed' && (
              <p>
                Online registration is closed.
                {current.walkIns && current.date && ` Walk-ins are welcome on ${formatDate(current.date)}.`}
              </p>
            )}
            {current.entryFee !== undefined && <p>Entry Fee: ${current.entryFee} per Competitor.</p>}
            {beneficiaryText && <p>Entry Fees support {beneficiaryText}.</p>}
            {(current.stage === 'upcoming' || current.stage === 'registration-open') &&
              (current.registration.formUrl ? (
                <a class="button" href={current.registration.formUrl}>
                  Register now <span aria-hidden="true">→</span>
                </a>
              ) : (
                <p class="link-soon">Registration link coming soon</p>
              ))}
          </div>
        ) : (
          <ComingSoon text="Registration details are coming soon." />
        )
      }
    </section>

    <section id="rounds-and-divisions">
      <h2>Rounds &amp; Divisions</h2>
      <div class="facts">
        <div class="card">
          <h3>Three Rounds</h3>
          <p>Every Competitor takes part in Sprint and Target. Only the top Competitors move on to Countdown.</p>
          <ul class="round-list">
            {
              rounds.map((round) => (
                <li>
                  <span class="round-name">{round.name}</span>
                  <span>{round.about}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="card">
          <h3>{countWord(divisions.length)} Divisions</h3>
          <p>
            Competitors are grouped by grade, so everyone competes against students of a similar age.
            {current?.grades && ` This year is open to ${current.grades.toLowerCase()}.`}
          </p>
          <ul class="chips">
            {
              divisions.map((division) => (
                <li>
                  {division.name}
                  {division.grades && <span class="chip-detail"> · {division.grades}</span>}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section id="sample-questions">
      <h2>Sample Questions</h2>
      <p>
        Try some questions from a past exam. They may not reflect the overall difficulty of the tests.
      </p>
      <a class="button" href="/sample-questions-2025.pdf">
        Sample Questions (PDF) <span aria-hidden="true">→</span>
      </a>
    </section>

    <section id="faq">
      <h2>FAQ</h2>
      <p class="faq-intro">
        Have another question? Email us at <a href="mailto:bc.routetosuccess@gmail.com">bc.routetosuccess@gmail.com</a>.
      </p>
      <div class="faq-list">
        {
          faqs.map((faq) => (
            <details class="card faq-item">
              <summary>{faq.q}</summary>
              <ul>
                {faq.a.map((point) =>
                  typeof point === 'string' ? (
                    <li>{point}</li>
                  ) : (
                    <li>
                      {point.text}
                      <ul>
                        {point.sub.map((sub) => (
                          <li>{sub}</li>
                        ))}
                      </ul>
                    </li>
                  ),
                )}
                {faq.link && (
                  <li>
                    <a href={faq.link.href}>{faq.link.text}</a>
                  </li>
                )}
              </ul>
            </details>
          ))
        }
      </div>
    </section>

    <section>
      <a class="button secondary" href="/math-competition/past">
        Past Competitions <span aria-hidden="true">→</span>
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .competition-hero {
    position: relative;
    background: var(--club-blue-soft);
    border-bottom: 2px solid var(--line);
  }

  .hero-inner {
    position: relative;
    display: grid;
    gap: 2rem;
    align-items: center;
    padding-block: 4.5rem 5.5rem;
  }

  /* Text sits on the dark water when the Theme has artwork. */
  .themed {
    color: var(--paper);
    border-bottom: 0;
  }

  .presents {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.875rem;
  }

  .times {
    color: var(--sun);
    font-size: 1.25rem;
    line-height: 1;
  }

  h1 {
    margin: 0;
  }

  h1 > span {
    display: block;
  }

  .edition {
    font-size: clamp(1.75rem, 6vw, 2.75rem);
    font-weight: 800;
    line-height: 1.05;
  }

  .event-name {
    font-size: clamp(2.75rem, 11vw, 5.5rem);
    font-weight: 800;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .theme-name {
    margin-top: 0.4rem;
    font-size: clamp(1.375rem, 4.5vw, 2rem);
    font-weight: 700;
    line-height: 1.1;
  }

  .school {
    margin-top: 0.75rem;
    font-size: clamp(1.125rem, 3.5vw, 1.5rem);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .themed .event-name {
    color: var(--paper);
    text-shadow: 0.06em 0.06em 0 var(--ink);
  }

  .details {
    display: grid;
    gap: 1rem;
    margin: 0;
    color: var(--ink);
  }

  .details div {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0.75rem;
  }

  .details div + div {
    padding-top: 1rem;
    border-top: 2px dashed var(--club-blue);
  }

  dt {
    font-weight: 800;
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    padding-top: 0.15rem;
  }

  dd {
    margin: 0;
    font-weight: 700;
  }

  @media (min-width: 52rem) {
    .hero-inner {
      grid-template-columns: 1.4fr 1fr;
      padding-block: 4.5rem 7rem;
    }

    /* With artwork, keep everything in the left column so the picture on the right stays in view. */
    .themed .hero-inner {
      grid-template-columns: minmax(0, 34rem);
    }
  }

  .intro {
    margin: 0 0 2.5rem;
  }

  .page-body h2 {
    margin: 0 0 1rem;
  }

  .register p {
    margin: 0 0 0.75rem;
    font-weight: 600;
  }

  .facts {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 44rem) {
    .facts {
      grid-template-columns: 1fr 1fr;
    }
  }

  .facts h3 {
    margin: 0 0 0.75rem;
  }

  .facts p {
    margin: 0 0 1rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chip-detail {
    font-weight: 500;
  }

  .faq-intro {
    margin: 0 0 1rem;
  }

  .faq-list {
    display: grid;
    gap: 0.75rem;
  }

  /* Squarer than the other cards, with less padding. */
  .faq-item {
    border-radius: 0.5rem;
    padding: 1.1rem 1.5rem;
  }

  .faq-item summary {
    cursor: pointer;
    font-weight: 700;
  }

  .faq-item ul {
    margin: 0.75rem 0 0;
    padding-left: 1.5rem;
  }

  .faq-item li + li {
    margin-top: 0.4rem;
  }

  .faq-item li ul {
    margin-top: 0.4rem;
  }

  .link-soon {
    display: inline-block;
    margin-top: 0.25rem;
    padding: 0.5rem 1rem;
    border: 2px dashed var(--line);
    border-radius: 999px;
    font-weight: 700;
  }

  /* Each Round's name as a chip, with what happens in it underneath. */
  .round-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .round-list li {
    display: grid;
    justify-items: start;
    gap: 0.4rem;
  }

  .round-list li + li {
    margin-top: 1.25rem;
  }

  .round-name {
    margin: 0;
    padding: 0.2rem 0.8rem;
    border: 2px solid var(--line);
    border-radius: 999px;
    background: var(--club-blue-soft);
    font-weight: 700;
  }

  .chips li {
    padding: 0.3rem 0.9rem;
    border: 2px solid var(--line);
    border-radius: 999px;
    background: var(--club-blue-soft);
    font-weight: 700;
  }
</style>
