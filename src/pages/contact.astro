---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Sparkle from '../components/Sparkle.astro';

const [user, domain] = ['contact', 'bcroutetosuccess.com'];
const email = `${user}@${domain}`;
---

<BaseLayout title="Contact" description="Contact Route to Success.">
  <PageHeader
    title="Contact"
    lead="Questions about the Math Competition, sponsoring, or the club? Email us."
  />
  <div class="container page-body">
    <a class="card email" href={`mailto:${email}`}>
      <Sparkle size="2rem" />
      <span class="email-label">Email</span>
      {/* On a narrow phone the address breaks after the @, never in the middle of a word. */}
      <span class="email-address">{user}@<wbr />{domain}</span>
    </a>
  </div>
</BaseLayout>

<style>
  .email {
    display: inline-flex;
    flex-direction: column;
    gap: 0.25rem;
    max-width: 100%;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .email:hover {
    transform: translateY(-3px);
    box-shadow: 0 0.45rem 0 var(--ink);
  }

  .email :global(.sparkle) {
    margin-bottom: 0.5rem;
    color: var(--club-blue);
  }

  .email-label {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* The address is the whole point of the page, so it gets heading size. */
  .email-address {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 5vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 0.2em;
  }
</style>
