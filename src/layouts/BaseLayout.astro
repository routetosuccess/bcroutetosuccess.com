---
import { Font } from 'astro:assets';
import Sparkle from '../components/Sparkle.astro';
import { getEvents, smallerEventsId } from '../lib/events';

interface Props {
  title: string;
  description?: string;
  // A Math Competition's Theme colour, layered on top of the club's light blue.
  accent?: string;
}

const { title, description = 'Route to Success, a student club at BASIS Chandler.', accent } = Astro.props;

// The Events dropdown: each main Event, then Smaller Events and Past Math Competitions.
const events = await getEvents();
const eventsMenu = [
  ...events.main.map((event) => ({ href: `/events#${event.id}`, label: event.name })),
  ...(events.smaller.length > 0 ? [{ href: `/events#${smallerEventsId}`, label: 'Smaller Events' }] : []),
  { href: '/math-competition/past', label: 'Past Math Competitions' },
];

type NavItem = { href: string; label: string; menu?: { href: string; label: string }[] };

const nav: NavItem[] = [
  { href: '/math-competition', label: 'Math Competition' },
  { href: '/events', label: 'Other Events', menu: eventsMenu },
  { href: '/about', label: 'About' },
  { href: '/sponsors', label: 'Sponsors' },
  { href: '/contact', label: 'Contact' },
];

const footer = [
  {
    heading: 'Math Competition',
    links: [
      { href: '/math-competition#register', label: 'Register' },
      { href: '/math-competition#rounds-and-divisions', label: 'Rounds & Divisions' },
      { href: '/math-competition#sample-questions', label: 'Sample Questions' },
      { href: '/math-competition#faq', label: 'FAQ' },
      { href: '/math-competition/past', label: 'Past Competitions' },
    ],
  },
  {
    heading: 'Club',
    links: [
      { href: '/about', label: 'About' },
      { href: '/contact', label: 'Contact' },
    ],
  },
  {
    heading: 'Support',
    links: [
      { href: '/sponsors', label: 'Sponsors' },
      { href: '/sponsors#prospectus', label: 'Prospectus' },
    ],
  },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#5a9bd5" />
    <!-- √2, from the club's "√2 Success" artwork (a pun on "Route to Success"). -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-raleway" preload />
    <title>{title === 'Route to Success' ? title : `${title} | Route to Success`}</title>
  </head>
  <body style={accent ? `--accent: ${accent}` : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/">
          <img src="/logo.jpg" alt="Route to Success home" width="554" height="302" />
        </a>
        <nav aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li class:list={{ 'has-menu': item.menu }}>
                  <a href={item.href} aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}>
                    {item.label}
                    {item.menu && (
                      <svg class="caret" viewBox="0 0 12 8" width="10" height="7" aria-hidden="true" focusable="false">
                        <path d="M1 1.5 6 6.5 11 1.5" />
                      </svg>
                    )}
                  </a>
                  {item.menu && (
                    <ul class="menu">
                      {item.menu.map((link) => (
                        <li>
                          <a href={link.href}>{link.label}</a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p class="footer-tagline">
          <Sparkle size="1.25rem" />
          Every route starts with a first step.
        </p>
        <div class="footer-grid">
          {
            footer.map((group) => (
              <section>
                <h2>{group.heading}</h2>
                <ul>
                  {group.links.map((link) => (
                    <li>
                      <a href={link.href}>{link.label}</a>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
        <p class="fine-print">Route to Success is a student club at BASIS Chandler.</p>
      </div>
    </footer>

    <script>
      // The Other Events menu opens on hover or keyboard focus (wide screens only). This tells screen readers
      // whether it's open, and lets Escape close it and put focus back on its link.
      document.querySelectorAll<HTMLElement>('.has-menu').forEach((item) => {
        const link = item.querySelector<HTMLElement>(':scope > a');
        const menu = item.querySelector<HTMLElement>('.menu');
        const update = () => link?.setAttribute('aria-expanded', String(menu ? getComputedStyle(menu).display !== 'none' : false));
        const reopen = () => {
          delete item.dataset.closed;
          requestAnimationFrame(update);
        };
        update();
        item.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape') return;
          item.dataset.closed = '';
          link?.focus();
          update();
        });
        item.addEventListener('mouseenter', () => requestAnimationFrame(update));
        item.addEventListener('focusin', () => requestAnimationFrame(update));
        item.addEventListener('mouseleave', reopen);
        item.addEventListener('focusout', (event) => {
          if (!item.contains(event.relatedTarget as Node | null)) reopen();
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    /* Club blue, taken from the club logo. Keep text on it dark: white text doesn't have enough contrast. */
    --club-blue: #5a9bd5;
    --club-blue-soft: #ebf3fa;
    /* Black ink, like the hand-drawn logo, with a navy tint so it sits well with the blue. */
    --ink: #0b2e4a;
    --ink-muted: #3d5a70;
    --paper: #ffffff;
    /* A highlighter yellow for the stop you're at and the words that matter most. Only ever put dark text on it. */
    --sun: #ffcb47;
    --accent: var(--club-blue);
    --radius: 1rem;
    /* Soft edges: a pale blue line and a blurred shadow, in place of dark outlines and hard offset shadows. */
    --line: #a9c8e4;
    --shadow: 0 2px 12px rgb(11 46 74 / 0.1);
    --shadow-raised: 0 4px 16px rgb(11 46 74 / 0.16);
    /* Both are Raleway for now; kept separate so headings could get their own font later. */
    --font-display: var(--font-raleway);
    --font-body: var(--font-raleway);

    color-scheme: light;
    font-family: var(--font-body);
    /* Raleway's default numbers dip below the line (like "2026" looking uneven); this makes them all full height. */
    font-variant-numeric: lining-nums;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--ink);
    background: var(--paper);
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
  }

  /* Anchor links stop short of the top so the section heading isn't hidden behind the sticky menu. */
  html {
    scroll-padding-top: 1.5rem;
  }

  @media (min-width: 52rem) {
    html {
      scroll-padding-top: 6rem;
    }
  }

  h1,
  h2,
  h3 {
    font-family: var(--font-display);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  h1 {
    font-size: clamp(2.25rem, 8vw, 4rem);
    font-weight: 800;
  }

  h2 {
    font-size: clamp(1.625rem, 5vw, 2.25rem);
    font-weight: 800;
  }

  h3 {
    font-size: 1.25rem;
    font-weight: 700;
  }

  a {
    color: inherit;
    text-underline-offset: 0.2em;
  }

  :focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
    border-radius: 0.25rem;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  .container {
    width: 100%;
    max-width: 68rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  /* Squared maths paper, used behind banners. */
  .graph-paper {
    background-color: var(--club-blue-soft);
    background-image:
      linear-gradient(color-mix(in srgb, var(--club-blue) 18%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--club-blue) 18%, transparent) 1px, transparent 1px);
    background-size: 1.5rem 1.5rem;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .lead {
    font-size: 1.1875rem;
    max-width: 38rem;
  }

  /* A highlighter stroke behind a word. */
  .highlight {
    background: linear-gradient(transparent 60%, var(--sun) 60%, var(--sun) 92%, transparent 92%);
    padding-inline: 0.1em;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.4rem;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-weight: 700;
    text-decoration: none;
    box-shadow: var(--shadow);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .button:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-raised);
  }

  .button:active {
    transform: translateY(2px);
    box-shadow: 0 1px 4px rgb(11 46 74 / 0.12);
  }

  .button.secondary {
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--shadow);
  }

  .button.secondary:hover {
    box-shadow: var(--shadow-raised);
  }

  .card {
    background: var(--paper);
    color: var(--ink);
    border: 2px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    padding: 1.5rem;
  }

  .section {
    padding-block: 3.5rem;
  }

  .page-body {
    padding-block: 2.5rem 4rem;
  }

  .page-body section + section {
    margin-top: 2.5rem;
  }

  /* A page drawn as the club's route: each section is a stop on a dotted line down the left,
     starting at a Club Blue dot and ending at the yellow star. Add class="route-stops" to a page body. */
  @media (min-width: 44rem) {
    .route-stops > section {
      position: relative;
      padding-left: 3.25rem;
    }

    /* The stop: a white dot in a navy ring, level with the section heading. */
    .route-stops > section::before {
      content: '';
      position: absolute;
      z-index: 1;
      left: 0;
      top: 0.35rem;
      width: 1.5rem;
      height: 1.5rem;
      border: 3px solid var(--ink);
      border-radius: 50%;
      background: var(--paper);
    }

    .route-stops > section:first-of-type::before {
      background: var(--club-blue);
    }

    /* The last stop is the club's star. */
    .route-stops > section:last-of-type::before {
      top: 0;
      left: -0.4rem;
      width: 2.3rem;
      height: 2.3rem;
      border: 0;
      border-radius: 0;
      background: var(--sun);
      clip-path: path('M18.4 0C19.9 12.3 24.5 16.9 36.8 18.4 24.5 19.9 19.9 24.5 18.4 36.8 16.9 24.5 12.3 19.9 0 18.4 12.3 16.9 16.9 12.3 18.4 0Z');
    }

    /* The dotted route from this stop down to the next one. */
    .route-stops > section:not(:last-of-type)::after {
      content: '';
      position: absolute;
      left: calc(0.75rem - 2px);
      top: 2.25rem;
      bottom: -2.25rem;
      border-left: 4px dotted color-mix(in srgb, var(--ink) 45%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 10;
    padding: 0.5rem 1rem;
    background: var(--ink);
    color: var(--paper);
    border-radius: 0.5rem;
  }

  .skip-link:focus {
    top: 1rem;
  }

  .site-header {
    background: var(--paper);
    border-bottom: 2px solid var(--line);
  }

  /* On phones the menu wraps onto two rows, which would cover too much of the screen if it stayed pinned. */
  @media (min-width: 52rem) {
    .site-header {
      position: sticky;
      top: 0;
      z-index: 5;
    }
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 0.5rem;
  }

  .brand {
    display: block;
    line-height: 0;
  }

  .brand img {
    height: 3.25rem;
    width: auto;
  }

  @media (min-width: 52rem) {
    .brand img {
      height: 4rem;
    }
  }

  nav ul,
  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  /* At least 44px tall, so they're easy to tap. */
  nav a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.55rem 0.8rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  nav a:hover {
    background: var(--club-blue-soft);
  }

  nav a[aria-current='page'] {
    background: var(--club-blue);
  }

  .has-menu {
    position: relative;
  }

  .has-menu > a {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .caret {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.15s ease;
  }

  /* Hidden until opened. On phones it stays hidden: there's no hover, and the Events page has the same links.
     Written as "nav .menu" so it outranks the "nav ul" rule above. */
  nav .menu,
  .caret {
    display: none;
  }

  @media (min-width: 52rem) {
    .caret {
      display: block;
    }

    /* Opens on hover, and when a keyboard user tabs onto Events or into the menu. */
    .has-menu:hover .menu,
    .has-menu:focus-within .menu {
      display: grid;
    }

    .has-menu:hover .caret,
    .has-menu:focus-within .caret {
      transform: rotate(180deg);
    }

    /* Escape closes it until the pointer or focus leaves (see the script below). */
    .has-menu[data-closed] .menu {
      display: none;
    }

    .has-menu[data-closed] .caret {
      transform: none;
    }

    .menu {
      position: absolute;
      top: 100%;
      left: 50%;
      z-index: 10;
      translate: -50% 0;
      min-width: 15rem;
      gap: 0.125rem;
      margin-top: 0.5rem;
      padding: 0.5rem;
      background: var(--paper);
      border: 2px solid var(--line);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }

    /* An invisible bridge across the gap, so the menu doesn't close as the pointer moves down to it. */
    .menu::before {
      content: '';
      position: absolute;
      inset: -0.75rem 0 100%;
    }

    /* Inside the menu the focus ring sits within the link, so it doesn't run into the menu's border. */
    .menu a:focus-visible {
      outline-offset: -3px;
    }

    .menu a {
      border-radius: 0.6rem;
      padding: 0.5rem 0.8rem;
      white-space: nowrap;
    }
  }

  .site-footer {
    background: var(--ink);
    color: var(--club-blue-soft);
    padding-block: 3rem 1.5rem;
    border-top: 0.5rem solid var(--club-blue);
  }

  .footer-tagline {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 2rem;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 4vw, 1.75rem);
    font-weight: 800;
    color: var(--paper);
  }

  .footer-tagline :global(.sparkle) {
    color: var(--sun);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1.5rem;
  }

  .site-footer h2 {
    font-size: 1rem;
    letter-spacing: 0;
    color: var(--club-blue);
    margin: 0 0 0.5rem;
  }

  .site-footer a {
    display: inline-block;
    padding-block: 0.55rem;
    text-decoration: none;
  }

  .site-footer a:hover {
    text-decoration: underline;
  }

  .site-footer :focus-visible {
    outline-color: var(--sun);
  }

  .fine-print {
    margin: 2.5rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px dashed color-mix(in srgb, var(--club-blue) 50%, transparent);
    font-size: 0.875rem;
  }
</style>
